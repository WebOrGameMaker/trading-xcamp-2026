# Alpaca Paper Trading API credentials (required for paper-trade / live dashboard only)
# Historical data is downloaded from Yahoo Finance and does not use these keys.
# Get keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Paper trading endpoint (required for safety)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: override config path
# CONFIG_PATH=configs/default.yaml
